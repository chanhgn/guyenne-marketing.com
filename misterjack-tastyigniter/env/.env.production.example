# TastyIgniter — Mister Jack (order.misterjack.ma)
# Copier en .env sur le serveur, puis compléter les identifiants MySQL.
# Ne jamais committer le .env réel : il contient le mot de passe base.

APP_NAME="Mister Jack"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://order.misterjack.ma

# multiple = deux établissements (Fès + Casablanca) avec sélection par le client
IGNITER_LOCATION_MODE=multiple
IGNITER_CARTE_KEY=

# Base créée dans hPanel > Bases de données MySQL.
# Le préfixe ti_ isole les tables au cas où la base serait partagée.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=ti_

# sync : les mails partent pendant la requête. Suffisant au volume d'un
# restaurant. Passer à database + worker cron si le checkout devient lent.
QUEUE_CONNECTION=sync
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_DRIVER=log

# SMTP Hostinger (Titan/Hostinger Email) — indispensable : sans mail sortant,
# ni le client ni le restaurant ne reçoivent la confirmation de commande.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=commandes@misterjack.ma
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=commandes@misterjack.ma
MAIL_FROM_NAME="Mister Jack"

# Clé Google utilisée UNIQUEMENT par le géocodage, côté serveur.
# Elle reste ici et jamais dans les réglages de l'admin : le champ « clé Google
# Maps » de TastyIgniter alimente aussi la carte affichée au client, donc une
# clé posée là se retrouve publiée dans le HTML. Restreindre cette clé aux
# adresses IP du serveur (IPv4 et préfixe IPv6) et à la seule Geocoding API.
# Champ des réglages laissé vide => la carte du client passe par OpenStreetMap.
GOOGLE_GEOCODER_KEY=
